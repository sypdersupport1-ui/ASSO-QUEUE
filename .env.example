# =============================================================================
# QueueFlow — Environment Variables Reference
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any real secrets to version control.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# All other variables are server-only and MUST NEVER be prefixed NEXT_PUBLIC_.
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC — Safe for browser exposure
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# SERVER-ONLY — NEVER expose these to client code or browser bundles
# -----------------------------------------------------------------------------

# Application
NODE_ENV=development
APPLICATION_URL=http://localhost:3000

# Supabase service role — bypasses RLS — KEEP SECRET
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct Postgres connection string — used by local scripts/tests only
# (the app itself uses the Supabase clients above). Never commit the real value.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Redis (optional — in-memory fallback is used if not set)
# Strongly recommended for production rate limiting and caching.
REDIS_URL=redis://localhost:6379

# Cron worker auth secret — required in production
# Set to a long random string (e.g. openssl rand -hex 32)
# Used by /api/cron/notifications and /api/cron/queue-maintenance when triggered
# over HTTP (manual runs or pg_net from pg_cron). Send as header:
#   Authorization: Bearer <CRON_SECRET>
# Never put the secret in a URL query string.
# NOTE: scheduling itself is FREE via pg_cron inside Postgres (no Vercel cron needed):
#   - queue maintenance runs as a direct DB call every minute (no secret needed)
#   - notifications run via pg_net HTTP POST to /api/cron/notifications (uses this secret)
#   See supabase/migrations/20260922000000_phase3a_pg_cron.sql for the pasteable setup.
CRON_SECRET=your-cron-secret-here

# -----------------------------------------------------------------------------
# PAYMENT PROVIDERS — Server-only (NEVER NEXT_PUBLIC_)
# -----------------------------------------------------------------------------

# Razorpay (optional — only required if using Razorpay payment provider)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Razorpay Webhook secret (from Razorpay dashboard → Webhooks → Secret)
# Used to verify webhook payload signatures
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
